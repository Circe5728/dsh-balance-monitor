{
  "name": "@local/dsh-balance-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sidebar wallet entry and draggable, pinnable balance/token-consumption window for DeepSeek accounts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Circe5728/dsh-balance-monitor.git"
  },
  "homepage": "https://github.com/Circe5728/dsh-balance-monitor#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  }
}
